# ── Client environment ───────────────────────────────────────────────────────
# Copy to .env.local for development, or set these in the hosting platform.
#
# NOTE: Next reads .env files from the CLIENT directory, not the monorepo root.
# A .env at the repo root is invisible to this app — every value below would be
# silently undefined and the fallbacks in src/config/site.js would be used
# instead, with no warning.

# Public origin of the marketing site. Baked in at BUILD time (NEXT_PUBLIC_*),
# so changing it requires a rebuild, not just a restart. Every canonical URL,
# every OG image URL and every @id in the structured data derives from this — if
# it is wrong, the whole site canonicalises to the wrong host.
NEXT_PUBLIC_SITE_URL=https://videofunker.ai

# Where /app, /login and /signup redirect to (see next.config.mjs).
NEXT_PUBLIC_APP_URL=https://app.videofunker.ai


# ── Blog source ──────────────────────────────────────────────────────────────
# LEAVE WP_API_URL UNSET to serve the posts committed in src/content/blog.
# Setting it switches the blog to headless WordPress. That single variable is
# the only switch — there is deliberately no separate BLOG_SOURCE flag, because
# a flag and a URL can disagree and produce a blog that throws on every route.

# WP_API_URL=https://cms.videofunker.ai/wp-json

# Public origin of the CMS. Used to rewrite links an editor wrote while inside
# WordPress so they point at this site instead of bouncing readers onto the CMS
# host. Set it whenever WP_API_URL is set.
# WP_PUBLIC_ORIGIN=https://cms.videofunker.ai

# Per-request timeout against WordPress. One slow _embed response should not be
# able to hang a reader's page.
# WP_TIMEOUT_MS=8000

# Bounded staleness for when the publish webhook is broken. Tag invalidation
# gives instant updates on the happy path; this only binds when that path is
# already dead. Never set it to false — "cache forever, the webhook will handle
# it" fails silently and permanently the day the webhook stops working.
# WP_FALLBACK_TTL=3600

# Draft preview only. Never used on a public path.
# WP_APP_USER=
# WP_APP_PASSWORD=

# Shared secret for POST /api/revalidate. The route returns 503 without it
# rather than failing open — an unauthenticated purge endpoint is a free
# denial-of-service against both this app and the WordPress box behind it.
# Generate with: openssl rand -hex 32
# REVALIDATE_SECRET=
