{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,

    /**
     * The product app was written and shipped under Vite's tsconfig, which had
     * `strict`, `strictNullChecks` and `noImplicitAny` all off. Turning them on
     * during a move does not find bugs, it finds several hundred pre-existing
     * type assertions that nobody is in a position to judge today, and it stops
     * the build. Tighten these deliberately, in their own change, with the
     * errors in front of you.
     */
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,

    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@product/*": ["./src/product/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
