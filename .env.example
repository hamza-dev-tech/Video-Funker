# ── Client (Next.js) ───────────────────────────────────────────────
# The product app lives on its own subdomain. Every "Start free" / "Log in"
# control on the marketing site points here.
NEXT_PUBLIC_APP_URL=https://app.videofunker.ai
NEXT_PUBLIC_SITE_URL=https://videofunker.ai
# Where the marketing form posts. Leave blank in dev to use the local BFF.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Server (Express BFF) ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the BFF.
CORS_ORIGINS=http://localhost:3000,https://videofunker.ai,https://www.videofunker.ai

# Where demo requests are delivered. All optional — without them the BFF
# still accepts and logs leads so the form never breaks in dev.
LEADS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEADS_TO_EMAIL=hello@videofunker.ai
