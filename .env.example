# This file is a MAP of the three services, not a file any of them reads.
# Each workspace loads its own:  client/.env.local, server/.env, api/.env.
# Copy the per-workspace .env.example files; a value written only here is
# silently ignored by all three.
#
#   client  :3000  Next.js — marketing site (/) and the product app (/app)
#   api     :3001  Express + MongoDB — auth, campaigns, content, video, billing
#   server  :4000  Express BFF — marketing lead capture only
#
# ── Client (Next.js) ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://videofunker.ai
# Where the marketing form posts. Leave blank in dev to use the local BFF.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the product app's API lives (the `api` workspace). See api/.env.example
# for everything that service itself needs.
NEXT_PUBLIC_PRODUCT_API_URL=http://localhost:3001/api
# Path the product SPA is mounted at. Must match the rewrite in next.config.mjs.
NEXT_PUBLIC_PRODUCT_BASE_PATH=/app

# ── Server (Express BFF) ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the BFF.
CORS_ORIGINS=http://localhost:3000,https://videofunker.ai,https://www.videofunker.ai

# Where demo requests are delivered. All optional — without them the BFF
# still accepts and logs leads so the form never breaks in dev.
LEADS_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEADS_TO_EMAIL=hello@videofunker.ai
