# ── Server environment (the marketing BFF) ───────────────────────────────────
# Copy to server/.env for development. Every value here has a working default,
# so the service runs with no .env at all — but the CORS default is narrow
# enough to bite you, so read that one.

# Port the BFF listens on. Default 4000. See the map in ../.env.example.
PORT=4000
NODE_ENV=development

# Browser origins allowed to POST /api/leads, comma separated.
# DEFAULT IF UNSET: http://localhost:3000 and nothing else. If the Next dev
# server is on any other port — and it will be, whenever 3000 is taken — the
# lead form fails its preflight with no Access-Control-Allow-Origin header.
CORS_ORIGINS=http://localhost:3000

# ── Lead delivery (both optional) ────────────────────────────────────────────
# With neither channel configured the lead is written to stdout instead, which
# is what you want locally: nothing leaves the machine.

# POST target for each captured lead (Zapier, Make, a CRM endpoint).
# LEADS_WEBHOOK_URL=

# SMTP delivery. All five are required together or the email channel is skipped.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# LEADS_TO_EMAIL=
