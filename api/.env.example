# ── Video Funker product API ─────────────────────────────────────────────────
# Copy to api/.env. Read by dotenv from THIS directory (npm --workspace api run
# dev sets the cwd here), so a .env at the monorepo root is invisible to it.
#
# The service boots and signup / login / the whole workspace UI work with only
# the first three blocks set. Everything below them switches on one feature each
# and, when absent, fails at the moment that feature is used rather than at boot.

# ── Required ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# The client's default API base is http://localhost:3001/api — see
# client/src/product/config.ts. Change one and change the other.
MONGODB_URI=mongodb://localhost:27017/videofunker

# Signing key for the JWT the app stores after login. Any long random string in
# development; a secret one in production. Changing it signs every user out.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call this API. The product
# app is served by the Next client, so these are the CLIENT's origins — not the
# API's. In development that is the Next dev server on :3000.
CORS_ORIGINS=http://localhost:3000,https://videofunker.ai,https://www.videofunker.ai,https://app.videofunker.ai
# Legacy single-origin form, still read when CORS_ORIGINS is unset.
# CLIENT_URL=http://localhost:3000

# ── Where the app lives ──────────────────────────────────────────────────────
# Origin PLUS the path the SPA is mounted at. Stripe Checkout and the billing
# portal send the customer back here, so it has to be the URL that actually
# renders the app — /app/pricing, not /pricing, which is a marketing 404.
#
# This is separate from CORS_ORIGINS on purpose: a CORS origin may not contain
# a path, and this one must.
APP_URL=http://localhost:3000/app

# ── OpenAI ───────────────────────────────────────────────────────────────────
# ICP generation, content generation and prospect research. Without it those
# three features return an error; nothing else is affected.
OPENAI_API_KEY=

# ── SendGrid ─────────────────────────────────────────────────────────────────
# Transactional email: the signup verification OTP and the password-reset OTP.
# Signup itself still succeeds without these — the account is created and the
# user is logged in, and only the verification mail fails (it is sent inside a
# try/catch that logs). Password reset, which is nothing but an emailed code,
# does not work at all until this is set.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@videofunker.ai
SENDGRID_FROM_NAME=Video Funker

# ── Stripe ───────────────────────────────────────────────────────────────────
# Subscriptions and the billing screen. Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Price ids of recurring monthly Prices created in Stripe.
# NOTE: the variable for the Enterprise plan is STRIPE_ENTERPRISE_MONTHLY.
# The old example file called it ENTERPRISE_MONTHLY, which config/plans.ts has
# never read — an Enterprise plan configured under that name was silently priceless.
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_ENTERPRISE_MONTHLY=price_xxx

# Webhook signing secret.
# Local: stripe listen --forward-to localhost:3001/api/billing/webhook
# Production: an endpoint at https://YOUR_DOMAIN/api/billing/webhook subscribed to
#   checkout.session.completed, customer.subscription.created/updated/deleted,
#   invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── HeyGen ───────────────────────────────────────────────────────────────────
# Avatar video generation and voice cloning (the Film and Avatar Studio tabs).
HEYGEN_API_KEY=
# Public URL HeyGen posts render callbacks to: https://YOUR_API_DOMAIN/api/heygen/webhook
HEYGEN_WEBHOOK_URL=

# ── LinkedIn OAuth ───────────────────────────────────────────────────────────
# Routes exist (GET /api/linkedin/auth/url, /auth/callback, /auth/status,
# POST /auth/disconnect) but NO screen in the app calls them yet, so nothing
# here is needed to run the product today.
#
# When it is wired up: this value must match the redirect URL registered on the
# LinkedIn app exactly, and it should point at the API's own callback — that is
# the handler that exchanges the code for a token. The old default pointed at
# the Vite dev server on :8080, at a path no route has ever served.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/linkedin/auth/callback

# ── Not listed here ──────────────────────────────────────────────────────────
# The four GOOGLE_* variables that used to sit at the bottom of this file are
# gone: no code in src/ reads any of them, there is no /api/auth/google/callback
# route to register as a redirect URI, and the `googleapis` dependency they
# implied has been dropped. Filling them in bought a Google Cloud OAuth client
# and no feature.

# Set to `console` in development to print OTPs to the API log instead of
# sending them. Ignored when NODE_ENV=production.
# EMAIL_TRANSPORT=console
